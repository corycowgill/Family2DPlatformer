{
  "name": "chicago-family-adventure",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run levels && npm run assets && tsc --noEmit && vite build",
    "assets": "node tools/art/build-manifest.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "levels": "node tools/levels/build-levels.mjs",
    "levels:check": "node tools/levels/build-levels.mjs --check && node tools/levels/check-reachability.mjs",
    "levels:reach": "node tools/levels/check-reachability.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "typescript": "5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
